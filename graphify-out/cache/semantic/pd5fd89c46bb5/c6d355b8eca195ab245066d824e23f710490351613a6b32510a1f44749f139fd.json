{"nodes": [{"id": "project_study_guide", "label": "Project Study Guide", "file_type": "document", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_study_guide_structured_outputs", "label": "Structured Outputs", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "chat.completions.parse(response_format=PydanticModel) validates model JSON before app code sees it, so malformed answers fail loudly instead of silently corrupting records."}, {"id": "project_study_guide_tool_calling_loop", "label": "Tool Use / Function Calling Loop", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model returns tool_calls; code executes local function, appends role:tool message, repeats until no more tool calls, then requests final structured answer. This is the mechanism every agent framework wraps."}, {"id": "project_study_guide_rag_from_scratch", "label": "RAG from Scratch (pgvector)", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "chunk -> embed -> store in pgvector -> cosine (<=>) search -> context-only prompt with [source:index] citations. pgvector chosen so retrieval is one SQL query with no separate vector DB service; no reranking/metadata filtering by design as a learning baseline."}, {"id": "project_study_guide_raw_agent_loop", "label": "Raw Agent Loop (no framework)", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-rolled bounded loop instead of LangChain/LangGraph/CrewAI so the fundamentals are readable and framework-based agents are easier to debug later."}, {"id": "project_study_guide_no_framework_principle", "label": "No LLM Framework Principle", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid LangChain/LangGraph/CrewAI so every abstraction can be read top to bottom; 'prove you understand the fundamentals' before adopting frameworks."}, {"id": "project_study_guide_secrets_hygiene", "label": "Secrets Hygiene (env vars via config.py)", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app/config.py is the only place env vars are read; .env git-ignored, .env.example documents required vars; switching provider/DB needs only .env changes."}, {"id": "project_study_guide_prompt_engineering_for_reliability", "label": "Prompt Engineering for Reliability", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L263", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System prompts (QUALIFY/ASK/AGENT) exist to constrain format and behavior (score range, answer only from context, call tool at most once)."}, {"id": "project_study_guide_router_boundary_mocking", "label": "Router-boundary Mocking in Tests", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L189", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests monkeypatch router-level functions (e.g. app.routers.qualify.qualify_lead) so the suite needs no API key or network; enables CI with a dummy key."}, {"id": "project_study_guide_mocked_crm_tools", "label": "Mocked CRM/Enrichment Tools (Acme Corp, Globex)", "file_type": "concept", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stand-ins for Apollo/Clay/HubSpot; swapping in a real API would only touch the two tool functions, not the loop."}, {"id": "project_study_guide_known_gaps", "label": "Known Gaps (no auth/rate-limit, no reranking)", "file_type": "concept", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L277", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "project_study_guide", "target": "readme", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L240", "weight": 1.0}, {"source": "project_study_guide", "target": "docs_refund_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L167", "weight": 1.0}, {"source": "project_study_guide", "target": "docs_product_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L168", "weight": 1.0}, {"source": "project_study_guide", "target": "docker_compose", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L171", "weight": 1.0}, {"source": "project_study_guide", "target": "_github_workflows_ci", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L172", "weight": 1.0}, {"source": "project_study_guide", "target": "project_study_guide_structured_outputs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": "L42", "weight": 1.0}, {"source": "project_study_guide", "target": "project_stud