{"nodes": [{"id": "claude_claude_md", "label": "CLAUDE.md Project Guide", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_no_agent_frameworks", "label": "Direct OpenAI SDK, No LangChain", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LangChain and agent frameworks are deliberately excluded; all LLM calls use the OpenAI SDK directly through one client factory."}, {"id": "claude_lazy_llm_client", "label": "Lazy LLM Client via get_client", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client is built lazily so importing any module never requires an API key; OPENAI_BASE_URL lets the same code hit any OpenAI-compatible endpoint."}, {"id": "claude_request_flow", "label": "Request Flow main -> routers -> logic", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routers stay thin (one call each); logic lives in app/llm.py, app/rag/qa.py, app/agent/loop.py; schemas in app/models.py."}, {"id": "claude_structured_output_pattern", "label": "Structured Output Pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "client.beta.chat.completions.parse with a Pydantic response_format; a None parsed result is treated as a refusal and raises ValueError."}, {"id": "claude_tool_loop_pattern", "label": "Tool Loop Pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call with tools=, dispatch tool_calls via _AVAILABLE_TOOLS, append role:tool messages, repeat up to max_turns, then a final parse call. The two loops are separate copies and must be kept in sync manually."}, {"id": "claude_rag_pipeline", "label": "RAG Pipeline (chunking, embeddings, store, qa)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw psycopg + pgvector table doc_chunks with cosine <=>; top-k chunks tagged [source:index] are stuffed into the prompt."}, {"id": "claude_embedding_dim_coupling", "label": "EMBEDDING_DIM tied to text-embedding-3-small", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EMBEDDING_DIM = 1536 in store.py; changing the embedding model requires a schema change."}, {"id": "claude_ingest_append_only", "label": "ingest_docs Append-Only Duplication", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "scripts.ingest_docs only appends rows, so rerunning it duplicates chunks."}, {"id": "claude_mocked_enrichment_tools", "label": "Mocked Enrichment Tools", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_lookup_company_firmographics and _search_company_info return hardcoded dicts standing in for real enrichment APIs."}, {"id": "claude_env_config", "label": "Env-Only Configuration", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Config comes only from environment variables via app/config.py with python-dotenv loading .env."}, {"id": "claude_router_monkeypatch_testing", "label": "Router-Level Monkeypatch Testing", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Tests", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests use TestClient and patch the function as imported into the router module so no network, API key or database is needed."}, {"id": "claude_graphify_rules", "label": "Graphify Usage Rules", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "graphify", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query the graph before raw browsing; run graphify update after code changes; large graph.json diffs are expected."}], "edges": [{"source": "claude_claude_md", "target": "claude_no_agent_frameworks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Architecture", "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_lazy_llm_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Architecture", "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_request_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Architecture", "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_structured_output_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Architecture", "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_tool_loop_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Architecture", "weight": 1.0}, {"source": "claude