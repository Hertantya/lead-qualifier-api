{"nodes": [{"id": "code_documentation_bilingual_documentation", "label": "Bilingual English and Bahasa Indonesia code documentation", "file_type": "document", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 1-450", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_documentation_direct_sdk", "label": "Plain Python AI patterns using the OpenAI SDK directly", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 35-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoiding LangChain, LangGraph and CrewAI makes each AI mechanism readable top-to-bottom for beginners without hidden framework behavior."}, {"id": "code_documentation_thin_routers", "label": "FastAPI entry point to thin routers to business logic to validated response", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 182-238; 406-450", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routers only receive requests, delegate to llm.py, rag/qa.py or agent/loop.py, and return results; the actual AI logic is kept outside routing."}, {"id": "code_documentation_environment_configuration", "label": "app/config.py: dotenv-backed OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL, OPENAI_EMBEDDING_MODEL and DATABASE_URL", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 94-110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralized environment configuration avoids hardcoded secrets and allows compatible provider or database changes through .env."}, {"id": "code_documentation_pydantic_contracts", "label": "Pydantic request/response contracts in app/models.py", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 114-133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contracts reject malformed requests before endpoint logic and define structured model outputs: qualification scores 1-10, nonempty descriptions, and AskRequest top_k default 4 bounded to 1-10."}, {"id": "code_documentation_structured_output", "label": "Structured output via beta.chat.completions.parse with Pydantic response_format", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 131-153; 167-178", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema-validated responses produce predictable fields instead of free text; a None parsed result raises an error rather than returning bad data."}, {"id": "code_documentation_tool_dispatch", "label": "Tool schemas and _AVAILABLE_TOOLS dispatch with role:tool conversation feedback", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 159-178; 347-374", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model requests named tools and arguments; local Python executes them, appends results and repeats before final structured parsing. Qualification permits 3 turns by default and research permits 4."}, {"id": "code_documentation_mock_enrichment", "label": "Mock firmographics and company-information tools for Acme Corp and Globex", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 155-157; 343-345", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_documentation_paragraph_chunking", "label": "Paragraph-aware chunking: 800-character target with 100-character overlap", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 242-254", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packing paragraphs creates focused retrieval units, while carrying the preceding chunk's tail preserves context near boundaries. Chunk stores source, index and text."}, {"id": "code_documentation_shared_embeddings", "label": "embed_texts batches document chunks and embeds online questions in the same vector space", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 258-266", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using the same embedding mechanism during ingestion and querying makes semantic comparison possible; one vector is returned per input text in input order."}, {"id": "code_documentation_doc_chunks", "label": "doc_chunks table: id, source, chunk_index, text and VECTOR(1536) embedding", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 270-290", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_documentation_cosine_retrieval", "label": "pgvector cosine-distance retrieval: ORDER BY embedding <=> query_embedding, LIMIT top_k", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 292-294", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The closest vectors represent the document chunks most semantically relevant to the question; smaller cosine distance means greater similarity."}, {"id": "code_documentation_context_grounding", "label": "ASK_SYSTEM_PROMPT: answer only from retrieved context, abstain if absent, cite [source:index]", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 304-329", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Context-only generation and explicit uncertainty instructions aim to reduce unsupported answers; the RAG answer uses ordinary chat completion rather than structured parsing."}, {"id": "code_documentation_citations", "label": "AskResponse includes answer and Citation objects containing source, chunk_index and text for retrieved chunks", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 125-127; 308-327", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_documentation_agent_final_answer", "label": "Private _AgentFinalAnswer: summary and draft_email; public response adds company_name and tool_calls", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 339-362", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model generates only summary and email, while application-owned company identity and tool-call history are added afterward. The prompt asks for two summary sentences and one lookup per company."}, {"id": "code_documentation_document_ingestion", "label": "Offline scripts.ingest_docs: initialize schema, read docs/*.md, chunk, batch embed, insert and close connection", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 378-402", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_documentation_health", "label": "GET /health returns status ok without AI or database access", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 196-198", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_lazy_client", "target": "claude_router_boundary_mocking", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 143-145", "weight": 1.0}, {"source": "claude_append_only_ingestion", "target": "code_documentation_document_ingestion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CODE_DOCUMENTATION.md", "source_location": "lines 401-402", "weight": 1.0}, {"source": "co