{"nodes": [{"id": "project_study_guide", "label": "Project Study Guide", "file_type": "document", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_study_guide_fundamentals_first", "label": "Learn Raw Fundamentals Before Frameworks", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Building the raw tool-calling loop and raw RAG pipeline makes debugging framework-based agents easier later, since frameworks like LangGraph merely wrap exactly this loop."}, {"id": "project_study_guide_mock_swappability", "label": "Mock Tools Are Isolated Swap Points", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replacing the mocks with real Apollo/Clay/HubSpot HTTP calls would only touch _lookup_company_firmographics and _search_company_info; nothing else in the loop changes."}, {"id": "project_study_guide_prompt_engineering_reliability", "label": "Prompt Engineering for Reliability, Not Cleverness", "file_type": "rationale", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every system prompt exists to constrain output format and behavior (score range, answer only from context, call the tool at most once), which is what production prompt engineering mostly is."}, {"id": "project_study_guide_known_gaps", "label": "Known Gaps: No Reranking, No Auth", "file_type": "concept", "source_file": "PROJECT_STUDY_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The RAG pipeline is intentionally the simplest working baseline (no rerank