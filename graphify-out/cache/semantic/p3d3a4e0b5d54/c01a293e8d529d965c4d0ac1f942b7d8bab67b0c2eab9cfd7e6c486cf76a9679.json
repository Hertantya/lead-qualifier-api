{"nodes": [{"id": "code_documentation", "label": "Lead Qualifier API Code Documentation", "file_type": "document", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_documentation_structured_output", "label": "Structured Output (parse with response_format)", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "client.beta.chat.completions.parse(response_format=PydanticModel) forces the model into a strict JSON shape; a None parse result is treated as a refusal and raises ValueError."}, {"id": "code_documentation_tool_calling_loop", "label": "Tool-Calling Loop (_AVAILABLE_TOOLS dispatch)", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model only requests tools; local code resolves the name through a _AVAILABLE_TOOLS name-to-function dict, runs it, and appends a role:\"tool\" message, repeating up to max_turns."}, {"id": "code_documentation_rag_pipeline", "label": "RAG Pipeline (Retrieve, Augment, Generate)", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_documentation_agent_loop", "label": "Hand-Rolled Agent Loop (research_lead)", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bounded for-loop with early break plus a final structured-output call is the same pattern every agent framework builds on, written explicitly instead of hidden in a library."}, {"id": "code_documentation_pydantic_contracts", "label": "Pydantic Request/Response Contracts", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schemas act as contracts so FastAPI rejects malformed requests before user code runs; QualifyResponse is reused as the AI response_format."}, {"id": "code_documentation_paragraph_chunking_overlap", "label": "Paragraph-Aware Chunking with Overlap", "file_type": "rationale", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chunks must be small enough to be relevant yet overlap enough (~100 chars, ~800 char windows) that an answer is not split across a boundary."}, {"id": "code_documentation_pgvector_cosine_search", "label": "pgvector Cosine Distance Search (<=>)", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrieval is one SQL query over doc_chunks ordered by the <=> cosine-distance operator; EMBEDDING_DIM = 1536 is tied to text-embedding-3-small so changing the model means changing the schema."}, {"id": "code_documentation_citation_tagging", "label": "Source:Index Citation Tagging", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ASK_SYSTEM_PROMPT forces answers only from provided context and cites [source:index], which is what reduces hallucination."}, {"id": "code_documentation_mocked_tools", "label": "Mocked Enrichment Tools (Acme Corp / Globex)", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoded dicts stand in for real Apollo/Clay/HubSpot calls; any other company name returns \"Unknown\" values."}, {"id": "code_documentation_ingest_pipeline", "label": "ingest_docs Ingestion Pipeline", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No duplicate check exists, so running the script twice inserts every chunk twice; it only appends rows."}, {"id": "code_documentation_config_env_only", "label": "Environment-Only Configuration (app/config.py)", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every module imports from config instead of reading os.environ, so switching provider or database only means editing .env."}, {"id": "code_documentation_request_flow", "label": "Thin Router Request Flow", "file_type": "concept", "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Request flow is app/main.py -> app/routers/* (thin, one call each) -> logic in llm.py, rag/qa.py or agent/loop.py, keeping routers logic-free."}], "edges": [{"source": "code_documentation", "target": "code_documentation_structured_output", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "weight": 1.0}, {"source": "code_documentation", "target": "code_documentation_tool_calling_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "weight": 1.0}, {"source": "code_documentation", "target": "code_documentation_rag_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CODE_DOCUMENTATION.md", "source_location": null, "weight": 1.0}, {"source": "code_documentation", "target